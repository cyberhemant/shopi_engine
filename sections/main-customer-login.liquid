<section class="section customer-page">
  <div class="page-width customer-page__content">
    <h1 class="section__heading">{{ 'customer.login.title' | t }}</h1>

    {% form 'customer_login', class: 'customer-form' %}
      {{ form.errors | default_errors }}
      <div class="customer-form__field">
        <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="customer-form__field">
        <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
      </div>
      <button type="submit" class="button">{{ 'customer.login.submit' | t }}</button>
    {% endform %}

    <details class="customer-page__disclosure">
      <summary>{{ 'customer.login.forgot_password' | t }}</summary>
      {% form 'recover_customer_password', class: 'customer-form customer-form--recovery' %}
        {% if form.posted_successfully? %}
          <p role="status">{{ 'customer.login.recover_success' | t }}</p>
        {% endif %}
        {{ form.errors | default_errors }}
        <div class="customer-form__field">
          <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input id="RecoverEmail" type="email" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="button">{{ 'customer.login.recover_submit' | t }}</button>
      {% endform %}
    </details>

    <p>{{ 'customer.login.create_account' | t }} <a href="{{ routes.account_register_url }}">{{ 'customer.register.submit' | t }}</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Customer login",
  "settings": [],
  "presets": [
    {
      "name": "Customer login"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .customer-page__content {
    max-width: min(var(--page-width), 36rem);
  }

  .customer-form {
    display: grid;
    gap: 1rem;
  }

  .customer-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .customer-form__field input {
    width: 100%;
    min-height: 46px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .customer-page__disclosure {
    margin-top: 1.5rem;
    color: var(--color-text);
  }

  .customer-form--recovery {
    margin-top: 1rem;
  }

  .customer-page__content > p a {
    color: var(--color-accent);
  }
{% endstylesheet %}