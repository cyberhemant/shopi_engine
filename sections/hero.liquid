<section class="section hero" id="shopify-section-{{ section.id }}">
  <div class="page-width hero__inner">
    {% if section.settings.image != blank %}
      <div class="hero__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 800, 1000, 1200', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'eager', alt: section.settings.image.alt | escape }}
      </div>
    {% endif %}

    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="section__heading">{{ section.settings.heading }}</h1>

      {% if section.settings.text != blank %}
        <p class="hero__text">{{ section.settings.text }}</p>
      {% endif %}

      <div class="hero__actions">
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {% endif %}

        {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modern essentials for everyday living"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bring thoughtful design into your daily routine with timeless pieces built to last."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Explore lookbook"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .hero__media {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-card-background);
    border: 1px solid var(--color-card-border);
  }

  .hero__media img {
    width: 100%;
    height: clamp(300px, 52vw, 680px);
    object-fit: cover;
  }

  .hero__content {
    display: grid;
    gap: 1rem;
  }

  .hero__text {
    max-width: 32rem;
    font-size: 1.05rem;
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media screen and (max-width: 767px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}
