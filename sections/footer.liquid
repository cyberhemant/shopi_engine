<footer class="footer" {{ section.shopify_attributes }}>
  <div class="page-width footer__inner">
    <div>
      <p class="footer__brand">{{ shop.name }}</p>
      {% if section.settings.text != blank %}
        <p class="footer__text">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {% if section.settings.menu != blank and linklists[section.settings.menu].links != blank %}
      <nav class="footer__nav" aria-label="Footer navigation">
        <ul class="footer__nav-list">
          {% for link in linklists[section.settings.menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    <p class="footer__meta">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Footer text",
      "default": "Modern essentials for everyday living."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-section);
  }

  .footer__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 0;
  }

  .footer__brand,
  .footer__meta {
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
  }

  .footer__text,
  .footer__nav-list a {
    color: var(--color-text);
    opacity: 0.8;
    text-decoration: none;
  }

  .footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  @media screen and (max-width: 767px) {
    .footer__inner {
      flex-direction: column;
    }
  }
{% endstylesheet %}
