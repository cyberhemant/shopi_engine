<section class="section password-page">
  <div class="page-width password-page__content">
    <p class="section__eyebrow">{{ shop.name | escape }}</p>
    <h1 class="section__heading">{{ 'sections.main_password.title' | t }}</h1>

    {% form 'storefront_password', class: 'password-page__form' %}
      {{ form.errors | default_errors }}
      <label for="StorefrontPassword">{{ 'sections.main_password.password_label' | t }}</label>
      <div class="password-page__controls">
        <input
          id="StorefrontPassword"
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="{{ 'sections.main_password.password_placeholder' | t }}"
          required
        >
        <button type="submit" class="button">{{ 'sections.main_password.submit' | t }}</button>
      </div>
    {% endform %}

    <p class="password-page__owner">
      {{ 'sections.main_password.store_owner' | t }}
      <a href="{{ shop.secure_url }}/admin">{{ 'sections.main_password.admin_link' | t }}</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Main password",
  "settings": [],
  "presets": [
    {
      "name": "Main password"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .password-page {
    min-height: 100vh;
    display: grid;
    align-items: center;
  }

  .password-page__content {
    max-width: min(var(--page-width), 42rem);
  }

  .password-page__form {
    display: grid;
    gap: 0.75rem;
  }

  .password-page__controls {
    display: flex;
    gap: 0.75rem;
  }

  .password-page__controls input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .password-page__owner {
    margin-top: 2rem;
    color: var(--color-text);
  }

  .password-page__owner a {
    color: var(--color-accent);
  }

  @media screen and (max-width: 479px) {
    .password-page__controls {
      flex-direction: column;
    }
  }
{% endstylesheet %}