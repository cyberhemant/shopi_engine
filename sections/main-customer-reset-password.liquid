<section class="section customer-page">
  <div class="page-width customer-page__content">
    <h1 class="section__heading">{{ 'customer.reset_password.title' | t }}</h1>

    {% form 'reset_customer_password', class: 'customer-form' %}
      {{ form.errors | default_errors }}
      <div class="customer-form__field">
        <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="customer-form__field">
        <label for="ResetPasswordConfirm">{{ 'customer.reset_password.confirm_password' | t }}</label>
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Customer reset password",
  "settings": [],
  "presets": [
    {
      "name": "Customer reset password"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .customer-page__content {
    max-width: min(var(--page-width), 36rem);
  }

  .customer-form {
    display: grid;
    gap: 1rem;
  }

  .customer-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .customer-form__field input {
    width: 100%;
    min-height: 46px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
  }
{% endstylesheet %}