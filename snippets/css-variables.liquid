{%- liquid
  assign body_font = settings.type_body_font
  assign heading_font = settings.type_heading_font
-%}

:root {
  --color-background: {{ settings.color_background }};
  --color-text: {{ settings.color_text }};
  --color-surface: {{ settings.color_surface }};
  --color-border: {{ settings.color_border }};
  --color-accent: {{ settings.color_accent }};
  --color-button-background: {{ settings.color_button_background }};
  --color-button-label: {{ settings.color_button_label }};
  --color-card-background: {{ settings.color_card_background }};
  --color-card-border: {{ settings.color_card_border }};
  --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
  --font-body-style: {{ body_font.style }};
  --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
  --font-heading-style: {{ heading_font.style }};
  --font-body-scale: {{ settings.type_body_scale | default: 100 | divided_by: 100.0 }};
  --font-heading-scale: {{ settings.type_heading_scale | default: 110 | divided_by: 100.0 }};
  --space-section: {{ settings.section_spacing }}px;
  --space-content: {{ settings.content_padding }}px;
  --page-width: {{ settings.page_width }}px;
  --radius-button: {{ settings.button_radius }}px;
  --radius-card: {{ settings.card_radius }}px;
}
